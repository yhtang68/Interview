{
  "name": "crd-portfolio-rebalancing-qa",
  "private": true,
  "dependencies": {
    "decimal.js": "^10.6.0",
    "wiremock": "^3.13.2"
  },
  "devDependencies": {
    "@cucumber/cucumber": "~12.5.0",
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.19.13",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "allure-commandline": "^2.42.0",
    "allure-cucumberjs": "^3.9.0",
    "allure-js-commons": "^3.9.0",
    "eslint": "^9.39.3",
    "globals": "^16.5.0",
    "gplint": "^2.5.1",
    "npm-run-all": "^4.1.5",
    "shx": "^0.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "del:packages": "shx rm -rf node_modules",
    "lint": "run-s lint:eslint lint:cucumber",
    "lint:cucumber": "gplint features -c ./.gplintrc",
    "lint:eslint": "eslint .",
    "mock:start": "pwsh -ExecutionPolicy Bypass -File ./wiremock/start-mock.ps1",
    "mock:start:debug": "pwsh -ExecutionPolicy Bypass -File ./wiremock/start-mock.ps1 -VerboseWireMock",
    "mock:stop": "pwsh -ExecutionPolicy Bypass -File ./wiremock/stop-mock.ps1",
    "reports": "run-s reports:generate reports:open",
    "reports:clear": "shx rm -rf results reports",
    "reports:generate": "allure generate ./results/allure-results -o ./reports/allure-report --clean --single-file",
    "reports:open": "pwsh -NoProfile -Command \"Start-Process './reports/allure-report/index.html'\"",
    "test": "pwsh -ExecutionPolicy Bypass -File ./run-tests.ps1 -TestEnv local",
    "test:local": "pwsh -ExecutionPolicy Bypass -File ./run-tests.ps1 -TestEnv local"
  }
}
